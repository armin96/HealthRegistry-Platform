<%- include('partials/header') %>

<!-- ═══ BACK NAV ═══ -->
<div class="animate-up">
  <a href="/patients" class="back-btn">← Back to Patient Explorer</a>
</div>

<!-- ═══ PAGE HEADER ═══ -->
<div class="page-header animate-up delay-1">
  <div class="page-header-info">
    <div class="page-breadcrumb">
      <span>◎</span> <span>Patients</span> <span>/</span> <span><%= patient.full_name %></span>
    </div>
    <h1 class="page-title"><%= patient.full_name %></h1>
    <p class="page-subtitle">
      Hybrid clinical profile — Administrative data from <span class="db-pill mysql" style="vertical-align:middle;">MySQL</span> &nbsp; Clinical history from <span class="db-pill mongo" style="vertical-align:middle;">MongoDB</span>
    </p>
  </div>
</div>

<!-- ═══ DETAIL GRID ═══ -->
<div class="detail-grid animate-up delay-2">

  <!-- LEFT: Demographics Card -->
  <div class="card patient-profile-card">
    <div class="card-body">
      <!-- Avatar -->
      <div class="patient-avatar-large" style="background:linear-gradient(135deg,rgba(124,58,237,0.2),rgba(6,182,212,0.2));">
        <%= patient.full_name.charAt(0) %>
      </div>
      <div class="patient-name"><%= patient.full_name %></div>
      <div class="patient-id">PID-<%= String(patient.patient_id).padStart(5,'0') %></div>

      <!-- Source label -->
      <div style="margin-top:1rem;">
        <span class="db-pill mysql">MySQL · Administrative Record</span>
      </div>

      <!-- Info list -->
      <ul class="info-list">
        <li>
          <label>Date of Birth</label>
          <span><%= new Date(patient.date_of_birth).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %></span>
        </li>
        <li>
          <label>Gender</label>
          <span><%= patient.gender.charAt(0).toUpperCase() + patient.gender.slice(1) %></span>
        </li>
        <li>
          <label>Blood Type</label>
          <span class="badge badge-success" style="font-size:0.82rem;"><%= patient.blood_type %></span>
        </li>
        <li>
          <label>Phone</label>
          <span style="font-family:'JetBrains Mono',monospace;font-size:0.8rem;"><%= patient.phone || 'N/A' %></span>
        </li>
        <li style="flex-direction:column;align-items:flex-start;gap:4px;">
          <label>Email</label>
          <span style="color:var(--primary-light);font-size:0.8rem;font-family:'JetBrains Mono',monospace;"><%= patient.email %></span>
        </li>
      </ul>

      <!-- Stats mini -->
      <div style="margin-top:1.5rem;display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
        <div class="vital-item" style="text-align:center;">
          <label>Visits</label>
          <span><%= records.length %></span>
        </div>
        <div class="vital-item" style="text-align:center;">
          <label>Lab Tests</label>
          <span><%= labs.length %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT: Clinical Records + Labs -->
  <div class="clinical-timeline">

    <!-- MongoDB header -->
    <div class="section-label">
      <span class="db-pill mongo">MongoDB · Clinical History</span>
      <span><%= records.length %> visits</span>
    </div>

    <% if (records.length === 0 && labs.length === 0) { %>
      <div class="card">
        <div class="empty-state">
          <div class="empty-state-icon">📂</div>
          <div class="empty-state-title">No Clinical Records Found</div>
          <div class="empty-state-text">This patient has no clinical history or lab results in MongoDB.</div>
        </div>
      </div>
    <% } %>

    <!-- Visit Records -->
    <% records.forEach((rec, i) => { %>
    <div class="clinical-record animate-up" style="animation-delay:<%= i * 0.06 %>s">
      <div class="record-header">
        <div>
          <div class="record-title">
            <span style="color:var(--primary-light);">⚕</span> Visit Record
          </div>
          <div style="margin-top:4px;font-size:0.78rem;color:var(--text-3);">
            Chief Complaint: <span style="color:var(--text-2);font-weight:500;"><%= rec.chief_complaint %></span>
          </div>
        </div>
        <div class="record-date"><%= new Date(rec.visit_date).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) %></div>
      </div>

      <!-- Diagnosis -->
      <div style="margin:0.75rem 0;display:flex;flex-wrap:wrap;gap:6px;">
        <% (Array.isArray(rec.diagnosis) ? rec.diagnosis : [rec.diagnosis]).forEach(d => { %>
          <span class="badge badge-purple"><%= d %></span>
        <% }) %>
      </div>

      <!-- Vitals -->
      <% if (rec.vitals) { %>
      <div class="vitals-grid">
        <div class="vital-item">
          <label>Blood Pressure</label>
          <span><%= rec.vitals.blood_pressure || '—' %></span>
        </div>
        <div class="vital-item">
          <label>Heart Rate</label>
          <span><%= rec.vitals.heart_rate || '—' %> <small style="font-size:0.6rem;color:var(--text-3);">bpm</small></span>
        </div>
        <div class="vital-item">
          <label>Weight</label>
          <span><%= rec.vitals.weight_kg || '—' %> <small style="font-size:0.6rem;color:var(--text-3);">kg</small></span>
        </div>
      </div>
      <% } %>
    </div>
    <% }) %>

    <!-- Lab Results -->
    <% if (labs.length > 0) { %>
    <div class="section-label" style="margin-top:1.5rem;">
      <span class="db-pill mongo">MongoDB · Lab Results</span>
      <span><%= labs.length %> tests</span>
    </div>

    <% labs.forEach((lab, i) => { %>
    <div class="clinical-record lab animate-up" style="animation-delay:<%= i * 0.05 %>s">
      <div class="record-header">
        <div>
          <div class="record-title">
            <span style="color:var(--amber);">🔬</span> <%= lab.test_name %>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="badge badge-<%= lab.status === 'final' ? 'success' : 'warning' %>"><%= lab.status %></span>
          <div class="record-date"><%= new Date(lab.resulted_at || lab.ordered_at).toLocaleDateString('en-GB',{day:'2-digit',month:'short'}) %></div>
        </div>
      </div>

      <% if (lab.results) { %>
      <div class="lab-results-grid">
        <% Object.entries(lab.results).forEach(([key, val]) => { %>
          <span class="lab-key"><%= key.toUpperCase() %></span>
          <span class="lab-value"><%= val %></span>
        <% }) %>
      </div>
      <% } %>

      <% if (lab.notes) { %>
        <div style="margin-top:0.75rem;font-size:0.78rem;color:var(--text-3);">Notes: <%= lab.notes %></div>
      <% } %>
    </div>
    <% }) %>
    <% } %>

  </div>
</div>

<%- include('partials/footer') %>