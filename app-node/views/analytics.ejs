<%- include('partials/header') %>

<!-- ═══ PAGE HEADER ═══ -->
<div class="page-header animate-up">
  <div class="page-header-info">
    <div class="page-breadcrumb">
      <span>◈</span> <span>Analytics</span>
    </div>
    <h1 class="page-title">Clinical Analytics</h1>
    <p class="page-subtitle">Aggregated insights from MongoDB pipelines &amp; MySQL JOIN queries</p>
  </div>
  <div class="page-actions">
    <a href="/api/stats" target="_blank" class="btn btn-outline btn-sm">
      View JSON API →
    </a>
  </div>
</div>

<!-- ═══ TOP STATS ═══ -->
<div class="grid-4 animate-up delay-1">
  <div class="card stat-card">
    <div class="stat-card-inner">
      <div class="stat-card-left">
        <div class="stat-label">Top Diagnosis</div>
        <div class="stat-val accent" style="font-size:1.6rem;"><%= topDiagnoses[0] ? topDiagnoses[0]._id : 'N/A' %></div>
        <div class="stat-delta"><%= topDiagnoses[0] ? topDiagnoses[0].count + ' cases recorded' : '' %></div>
      </div>
      <div class="stat-icon-wrap purple">🔬</div>
    </div>
  </div>
  <div class="card stat-card">
    <div class="stat-card-inner">
      <div class="stat-card-left">
        <div class="stat-label">Top Medication</div>
        <div class="stat-val accent" style="font-size:1.5rem;letter-spacing:-0.01em;"><%= topMeds[0] ? topMeds[0].medication_name : 'N/A' %></div>
        <div class="stat-delta"><%= topMeds[0] ? topMeds[0].times_prescribed + ' prescriptions' : '' %></div>
      </div>
      <div class="stat-icon-wrap cyan">💊</div>
    </div>
  </div>
  <div class="card stat-card">
    <div class="stat-card-inner">
      <div class="stat-card-left">
        <div class="stat-label">Active Specialties</div>
        <div class="stat-val" data-target="10">0</div>
        <div class="stat-delta">10 clinical specializations</div>
      </div>
      <div class="stat-icon-wrap green">⚕</div>
    </div>
  </div>
  <div class="card stat-card">
    <div class="stat-card-inner">
      <div class="stat-card-left">
        <div class="stat-label">Total Records</div>
        <div class="stat-val" data-target="1900">0</div>
        <div class="stat-delta">globally unique dataset</div>
      </div>
      <div class="stat-icon-wrap amber">📊</div>
    </div>
  </div>
</div>

<!-- ═══ ANALYTICS CHARTS GRID ═══ -->
<div class="grid-2 animate-up delay-2">

  <!-- Top Diagnoses -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">
        <div class="card-icon" style="background:rgba(124,58,237,0.15);">🔬</div>
        Top Diagnoses
      </div>
      <span class="db-pill mongo">MongoDB Aggregation</span>
    </div>
    <div class="card-body" style="padding-top:0;">
      <%
        const maxDiag = topDiagnoses[0] ? topDiagnoses[0].count : 1;
      %>
      <div class="mini-bar-chart">
        <% topDiagnoses.forEach((d, i) => {
          const pct = Math.round((d.count / maxDiag) * 100);
          const colors = ['purple','cyan','green','amber','rose'];
        %>
        <div class="mini-bar-row">
          <span class="mini-bar-label" title="<%= d._id %>"><%= d._id %></span>
          <div class="mini-bar-track">
            <div class="mini-bar-fill <%= colors[i % 5] %>" data-pct="<%= pct %>" style="width:0%"></div>
          </div>
          <span class="mini-bar-val"><%= d.count %></span>
        </div>
        <% }) %>
      </div>
      <div style="margin-top:1.5rem;padding:0.75rem;background:rgba(255,255,255,0.03);border-radius:var(--radius-sm);border:1px solid var(--border);">
        <div class="section-label" style="margin-bottom:0.5rem;">Aggregation Pipeline</div>
        <code style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--cyan);">
          $unwind → $group → $sort → $limit
        </code>
      </div>
    </div>
  </div>

  <!-- Top Medications -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">
        <div class="card-icon" style="background:rgba(6,182,212,0.15);">💊</div>
        Top Prescribed Medications
      </div>
      <span class="db-pill mysql">MySQL GROUP BY</span>
    </div>
    <div class="card-body" style="padding-top:0;">
      <%
        const maxMed = topMeds[0] ? topMeds[0].times_prescribed : 1;
      %>
      <div class="mini-bar-chart">
        <% topMeds.forEach((m, i) => {
          const pct = Math.round((m.times_prescribed / maxMed) * 100);
          const colors = ['cyan','purple','green','amber','rose'];
        %>
        <div class="mini-bar-row">
          <span class="mini-bar-label" title="<%= m.medication_name %>"><%= m.medication_name %></span>
          <div class="mini-bar-track">
            <div class="mini-bar-fill <%= colors[i % 5] %>" data-pct="<%= pct %>" style="width:0%"></div>
          </div>
          <span class="mini-bar-val"><%= m.times_prescribed %></span>
        </div>
        <% }) %>
      </div>
      <div style="margin-top:1.5rem;padding:0.75rem;background:rgba(255,255,255,0.03);border-radius:var(--radius-sm);border:1px solid var(--border);">
        <div class="section-label" style="margin-bottom:0.5rem;">SQL Query</div>
        <code style="font-family:'JetBrains Mono',monospace;font-size:0.7rem;color:var(--cyan);">
          SELECT medication_name, COUNT(*) AS times_prescribed FROM prescriptions GROUP BY medication_name ORDER BY times_prescribed DESC
        </code>
      </div>
    </div>
  </div>

</div>

<!-- ═══ DOCTOR LEADERBOARD ═══ -->
<div class="card animate-up delay-3">
  <div class="card-header">
    <div class="card-title">
      <div class="card-icon" style="background:rgba(16,185,129,0.15);">🏆</div>
      Doctor Appointment Leaderboard
    </div>
    <span class="db-pill mysql">MySQL LEFT JOIN + GROUP BY</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:50px;">Rank</th>
          <th>Physician</th>
          <th>Specialization</th>
          <th>Total Appointments</th>
          <th>Performance</th>
        </tr>
      </thead>
      <tbody>
        <%
          const maxDoc = doctorRanks[0] ? doctorRanks[0].total_appointments : 1;
          doctorRanks.forEach((doc, i) => {
            const pct = Math.round((doc.total_appointments / maxDoc) * 100);
            const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `#${i+1}`;
        %>
        <tr>
          <td>
            <span style="font-size:<%= i < 3 ? '1.2rem' : '0.85rem' %>;color:var(--text-3);font-family:'JetBrains Mono',monospace;">
              <%= medal %>
            </span>
          </td>
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              <div class="avatar" style="background:rgba(124,58,237,0.15);color:var(--primary-light);font-size:0.75rem;">
                <%= doc.full_name.replace('Dr. ','').charAt(0) %>
              </div>
              <strong><%= doc.full_name %></strong>
            </div>
          </td>
          <td>
            <span class="badge badge-<%= i < 3 ? 'purple' : 'neutral' %>"><%= doc.specialization %></span>
          </td>
          <td>
            <span style="font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--text-1);"><%= doc.total_appointments %></span>
          </td>
          <td style="width:200px;">
            <div class="mini-bar-track" style="height:8px;">
              <div class="mini-bar-fill purple" data-pct="<%= pct %>" style="width:0%;height:100%;border-radius:4px;"></div>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
